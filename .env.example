# Copie para .env e ajuste se precisar: "cp .env.example .env".
# Todos os valores abaixo já são os padrões do servidor.
# Este arquivo não contém segredos: o laboratório não usa credenciais.

# --- PokéAPI ---
# Base fixa das consultas. As Tools nunca aceitam URL como argumento.
POKEAPI_BASE_URL=https://pokeapi.co/api/v2/
# Tempo limite de cada consulta HTTP, em segundos.
POKEAPI_TIMEOUT_SECONDS=10
# Cache em memória: validade de cada entrada, em segundos.
POKEAPI_CACHE_TTL_SECONDS=300
# Cache em memória: número máximo de entradas (descarte LRU).
POKEAPI_CACHE_MAX_ENTRIES=256

# --- Servidor MCP ---
# Dentro do contêiner o servidor escuta em todas as interfaces; o compose
# publica a porta somente em 127.0.0.1.
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_PATH=/mcp
MCP_LOG_LEVEL=INFO

# --- Proteção contra DNS rebinding (Host e Origin) ---
# Listas separadas por vírgula. Mantenha-as restritas: este é um laboratório
# local. Host fora da lista responde HTTP 421; Origin fora da lista, HTTP 403.
MCP_ALLOWED_HOSTS=127.0.0.1:8000,localhost:8000,[::1]:8000
MCP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://[::1]:8000
