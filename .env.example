# Copie para .env e ajuste se precisar: "cp .env.example .env".
# Todos os valores abaixo já são os padrões do servidor.
# Este arquivo não contém segredos: o laboratório não usa credenciais.

# --- PokéAPI ---
# Base fixa das consultas. As Tools nunca aceitam URL como argumento.
POKEAPI_BASE_URL=https://pokeapi.co/api/v2/
# Tempo limite de cada consulta HTTP, em segundos. Precisa ser um número
# finito MAIOR que zero.
POKEAPI_TIMEOUT_SECONDS=10
# Cache em memória: validade de cada entrada, em segundos. Número finito e não
# negativo; 0 desliga o cache.
POKEAPI_CACHE_TTL_SECONDS=300
# Cache em memória: número máximo de entradas (descarte LRU). Inteiro não
# negativo; 0 desliga o cache.
POKEAPI_CACHE_MAX_ENTRIES=256

# Valor fora dessas regras (texto, negativo, "nan", "inf") não chega ao cliente
# HTTP nem ao cache: o servidor registra um aviso no log e usa o padrão acima.

# --- Servidor MCP ---
# Dentro do contêiner o endereço é FIXO em 0.0.0.0:8000 com o endpoint /mcp.
# Isso não é configurável de propósito: healthcheck, smoke test e allowlist de
# Host dependem desse valor e ficariam inconsistentes se cada um mudasse por
# conta própria.

# Porta publicada na SUA máquina (sempre em 127.0.0.1). Mude apenas se a 8000
# já estiver ocupada. Consequências de mudar:
#   - o endpoint do cliente vira http://localhost:<MCP_HOST_PORT>/mcp;
#   - o compose já acrescenta essa porta às allowlists de Host e Origin;
#   - um smoke test rodado FORA do Docker precisa da nova URL:
#     python scripts/smoke_test.py http://localhost:<MCP_HOST_PORT>/mcp
#   - o smoke rodado pelo compose continua usando http://localhost:8000/mcp,
#     porque ele compartilha a rede do contêiner do servidor.
MCP_HOST_PORT=8000

MCP_LOG_LEVEL=INFO

# --- Proteção contra DNS rebinding (Host e Origin) ---
# Listas separadas por vírgula. Host fora da lista responde HTTP 421; Origin
# fora da lista, HTTP 403. A proteção fica sempre ligada.
#
# A allowlist final que o servidor usa é a SOMA de três partes:
#
#   1. mínimos obrigatórios, fixos no código (src/pokemon_mcp/__main__.py):
#      127.0.0.1:8000, localhost:8000 e [::1]:8000 — a porta INTERNA do
#      contêiner, usada pelo healthcheck e pelo contêiner de smoke;
#   2. MCP_ALLOWED_HOSTS / MCP_ALLOWED_ORIGINS, que o compose.yaml deriva de
#      MCP_HOST_PORT (a porta publicada na sua máquina). Definir estas duas
#      variáveis aqui NÃO tem efeito quando você sobe pelo Compose: o
#      compose.yaml as monta sozinho. Elas existem para quem roda o servidor
#      fora do Docker;
#   3. MCP_EXTRA_ALLOWED_HOSTS / MCP_EXTRA_ALLOWED_ORIGINS — estas sim são
#      lidas deste arquivo. É aqui que você acrescenta um nome de host seu.
#
# Somar em vez de substituir é proposital: assim um extra mal preenchido nunca
# remove localhost/127.0.0.1 e derruba o laboratório. Mantenha a lista curta:
# este é um laboratório local.
#
# Exemplo (descomente e ajuste):
# MCP_EXTRA_ALLOWED_HOSTS=meu-host.local:8000
# MCP_EXTRA_ALLOWED_ORIGINS=http://meu-host.local:8000
#
# Resultado, com MCP_HOST_PORT=8001 e o exemplo acima:
#   Host:   127.0.0.1:8000, localhost:8000, [::1]:8000,
#           127.0.0.1:8001, localhost:8001, [::1]:8001,
#           meu-host.local:8000
